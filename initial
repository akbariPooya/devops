#!/usr/bin/env bash
#
# install.sh - Install Docker, Docker Compose plugin, Portainer, Git, GitHub CLI, zip/unzip, make
# Fixed & hardened version with clear CLI output.
#
set -euo pipefail

# ------------------------------------------------------------------
# Colors & helpers for nice CLI output
# ------------------------------------------------------------------
if [[ -t 1 ]]; then
  BOLD="$(tput bold)"; DIM="$(tput dim)"; RESET="$(tput sgr0)"
  RED="$(tput setaf 1)"; GREEN="$(tput setaf 2)"; YELLOW="$(tput setaf 3)"
  BLUE="$(tput setaf 4)"; CYAN="$(tput setaf 6)"
else
  BOLD=""; DIM=""; RESET=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""
fi

STEP_NUM=0
TOTAL_STEPS=10

section() {
  STEP_NUM=$((STEP_NUM + 1))
  echo
  echo -e "${BLUE}${BOLD}┌───────────────────────────────────────────────────────────┐${RESET}"
  printf "${BLUE}${BOLD}│${RESET} ${CYAN}${BOLD}[%d/%d]${RESET} %-52s ${BLUE}${BOLD}│${RESET}\n" "$STEP_NUM" "$TOTAL_STEPS" "$1"
  echo -e "${BLUE}${BOLD}└───────────────────────────────────────────────────────────┘${RESET}"
}

info()    { echo -e "  ${DIM}→${RESET} $1"; }
success() { echo -e "  ${GREEN}✔${RESET} $1"; }
warn()    { echo -e "  ${YELLOW}⚠${RESET} $1"; }
fail()    { echo -e "  ${RED}✖${RESET} $1"; }

# confirm "Question text" -> returns 0 (yes) or 1 (no). Default = No.
confirm() {
  local prompt="$1"
  local reply
  read -r -p "$(echo -e "  ${CYAN}?${RESET} ${prompt} ${DIM}[y/N]${RESET} ")" reply
  case "$reply" in
    [yY][eE][sS]|[yY]) return 0 ;;
    *) return 1 ;;
  esac
}

on_error() {
  local exit_code=$?
  local line_no=$1
  echo
  fail "Script failed at line ${line_no} (exit code ${exit_code})."
  fail "Aborting installation."
  exit "$exit_code"
}
trap 'on_error $LINENO' ERR

banner() {
  echo -e "${BOLD}${CYAN}"
  cat <<'EOF'
  ╔══════════════════════════════════════════════════════╗
  ║   Docker + Portainer + Dev Tools  —  Setup Script     ║
  ╚══════════════════════════════════════════════════════╝
EOF
  echo -e "${RESET}"
}

# ------------------------------------------------------------------
# Pre-flight checks
# ------------------------------------------------------------------
banner

if [[ $EUID -eq 0 ]]; then
  SUDO=""
  REAL_USER="${SUDO_USER:-root}"
else
  SUDO="sudo"
  REAL_USER="${SUDO_USER:-$USER}"
fi
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"

if ! command -v apt-get >/dev/null 2>&1; then
  fail "This script only supports Debian/Ubuntu based systems (apt-get not found)."
  exit 1
fi

ARCH="$(dpkg --print-architecture)"
info "Detected user: ${BOLD}${REAL_USER}${RESET} (home: ${REAL_HOME})"
info "Detected architecture: ${BOLD}${ARCH}${RESET}"

# ------------------------------------------------------------------
# 1) Optional: Set Shekan DNS
# ------------------------------------------------------------------
section "Shekan DNS (optional)"

if confirm "Do you want to set Shekan DNS (178.22.122.100 / 185.51.200.2)?"; then
  info "Backing up current /etc/resolv.conf to /etc/resolv.conf.bak"
  $SUDO cp /etc/resolv.conf /etc/resolv.conf.bak 2>/dev/null || true

  $SUDO bash -c 'printf "nameserver 178.22.122.100\nnameserver 185.51.200.2\n" > /etc/resolv.conf'
  success "Shekan DNS has been set"
else
  info "Skipping Shekan DNS setup"
fi

# ------------------------------------------------------------------
# 2) Remove old Docker packages
# ------------------------------------------------------------------
section "Removing old Docker packages"
$SUDO apt-get remove -y docker docker-engine docker.io containerd runc >/dev/null 2>&1 || true
success "Old Docker packages cleaned up (if any existed)"

# ------------------------------------------------------------------
# 3) Install prerequisites
# ------------------------------------------------------------------
section "Installing prerequisites"
$SUDO apt-get update -y
$SUDO apt-get install -y ca-certificates curl gnupg lsb-release software-properties-common
success "Prerequisites installed"

# ------------------------------------------------------------------
# 4) Install Docker Engine + Compose plugin
# ------------------------------------------------------------------
section "Installing Docker Engine"

if command -v docker >/dev/null 2>&1; then
  warn "Docker is already installed ($(docker --version)), skipping install steps"
else
  $SUDO install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | $SUDO gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  $SUDO chmod a+r /etc/apt/keyrings/docker.gpg

  echo \
    "deb [arch=${ARCH} signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    $(lsb_release -cs) stable" | $SUDO tee /etc/apt/sources.list.d/docker.list > /dev/null

  $SUDO apt-get update -y
  # docker-compose-plugin replaces the old manual binary download:
  # it's multi-arch, kept up to date via apt, and integrates as `docker compose`.
  $SUDO apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

  success "Docker Engine installed: $(docker --version)"
fi

success "Docker Compose plugin: $(docker compose version)"

$SUDO systemctl enable docker >/dev/null 2>&1 || true
$SUDO systemctl daemon-reload
$SUDO systemctl restart docker
success "Docker service (re)started"

# Add the real (non-root) user to the docker group
if id -nG "$REAL_USER" | grep -qw docker; then
  info "User '${REAL_USER}' is already in the docker group"
else
  $SUDO usermod -aG docker "$REAL_USER"
  success "User '${REAL_USER}' added to the docker group"
fi

# ------------------------------------------------------------------
# 5) Install Portainer
# ------------------------------------------------------------------
section "Installing Portainer"

$SUDO docker rm -f portainer >/dev/null 2>&1 || true
$SUDO docker volume create portainer_data >/dev/null
info "Pulling and starting Portainer container..."

$SUDO docker run -d \
  -p 9000:9000 \
  -p 9443:9443 \
  --name=portainer \
  --restart=unless-stopped \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v portainer_data:/data \
  portainer/portainer-ce:latest >/dev/null

success "Portainer is running (HTTP: http://<server-ip>:9000, HTTPS: https://<server-ip>:9443)"

# ------------------------------------------------------------------
# 6) Install Git
# ------------------------------------------------------------------
section "Installing Git"
$SUDO apt-get install -y git
success "Git installed: $(git --version)"

# ------------------------------------------------------------------
# 7) Install GitHub CLI (gh)
# ------------------------------------------------------------------
section "Installing GitHub CLI (gh)"

if command -v gh >/dev/null 2>&1; then
  warn "GitHub CLI is already installed ($(gh --version | head -n1)), skipping"
else
  $SUDO install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | $SUDO gpg --dearmor -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
  $SUDO chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg

  echo "deb [arch=${ARCH} signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | $SUDO tee /etc/apt/sources.list.d/github-cli.list > /dev/null

  $SUDO apt-get update -y
  $SUDO apt-get install -y gh
  success "GitHub CLI installed: $(gh --version | head -n1)"
fi

# ------------------------------------------------------------------
# 8) Install zip / unzip
# ------------------------------------------------------------------
section "Installing zip & unzip"
$SUDO apt-get install -y zip unzip
success "zip and unzip installed"

# ------------------------------------------------------------------
# 9) Install make
# ------------------------------------------------------------------
section "Installing make"
$SUDO apt-get install -y make
success "make installed: $(make --version | head -n1)"

# ------------------------------------------------------------------
# 10) Summary
# ------------------------------------------------------------------
section "Done"

echo -e "${GREEN}${BOLD}  All packages were installed successfully!${RESET}"
echo
printf "  %-22s %s\n" "Docker:"          "$(docker --version)"
printf "  %-22s %s\n" "Docker Compose:"  "$(docker compose version --short 2>/dev/null || echo 'installed')"
printf "  %-22s %s\n" "Git:"             "$(git --version)"
printf "  %-22s %s\n" "GitHub CLI:"      "$(gh --version | head -n1)"
printf "  %-22s %s\n" "Portainer:"       "running on ports 9000 (HTTP) / 9443 (HTTPS)"
echo
warn "To use Docker without 'sudo', log out and back in, or run:"
echo -e "      ${BOLD}newgrp docker${RESET}"
echo
